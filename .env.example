# ==========================================
# CUI Member Skill - 環境變數設定檔 (.env)
# ==========================================

# -------------------------
# 共用設定 (Shared Settings)
# -------------------------
# Whisper 模式: local (本地端), openai (OpenAI API), azure (Azure OpenAI API)
WHISPER_MODE=local

# Optional cross-platform settings
# Optional browser cookies for yt-dlp (e.g. chrome, firefox, edge).
# Alternatively set COOKIES_PATH to an exported cookies.txt file.
COOKIES_BROWSER=

# Apple Silicon only; Windows/Linux local transcription uses CPU faster-whisper.
WHISPER_MODEL=mlx-community/whisper-medium-mlx-8bit


# -------------------------
# yt-dlp cookies (relative paths are rooted at the repository)
# -------------------------
COOKIES_PATH=./cookies.txt

# [OpenAI API 模式專用]
OPENAI_API_KEY=your_openai_api_key_here

# [Azure OpenAI API 模式專用]
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=whisper
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# -------------------------
# Step 5: 同步至 Gist 配置 (選擇性)
# -------------------------
# 備註：若未同時填寫以下兩項，系統將自動跳過 Gist 同步功能
# GitHub Personal Access Token (需具備 gist 權限)
GITHUB_TOKEN=your_github_token_here
# 目標 Gist ID (例如 gist.github.com/username/GIST_ID 中的英數代碼)
GIST_ID=your_gist_id_here

